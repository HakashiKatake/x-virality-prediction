{
  "model": "HistGradientBoostingClassifier",
  "target": "is_viral",
  "target_definition": "90th percentile of training engagement",
  "prediction_threshold": 0.30000000000000004,
  "features": [
    "char_count",
    "word_count",
    "hashtag_count",
    "mention_count",
    "url_count",
    "year",
    "month",
    "day_of_week",
    "hour",
    "is_weekend",
    "log_followers",
    "log_following",
    "follower_following_ratio",
    "is_verified",
    "account_age_days",
    "prev_tweet_count",
    "prev_avg_engagement",
    "prev_viral_count",
    "historical_viral_rate"
  ]
}